#!/bin/bash
# install_callback — 安装后初始化 dsh-console
#
# 这个套件**不内置** dsh 本体: dsh 版本由后台按需从 npm 下载到
# ${DATA_DIR}/versions/<version>. 版本的选择与安装统一放在面板的
# Versions 标签页里, 安装向导不再收集版本号.
set -uo pipefail

APP_NAME="${TRIM_APPNAME:-dsh-console}"
APP_DIR="${TRIM_APPDEST:-/var/apps/${APP_NAME}}"

# ── 卷与数据目录定位 ──
# 同 cmd/main: 优先官方 TRIM_APPDEST_VOL, 否则 readlink 推导 /vol{n}.
APP_VOL="${TRIM_APPDEST_VOL:-}"
if [ -z "${APP_VOL}" ]; then
    for probe in "${APP_DIR}/home" "${APP_DIR}"; do
        APP_VOL="$(readlink -f "${probe}" 2>/dev/null | sed -n 's#^\(/vol[^/]*\)/.*#\1#p')"
        [ -n "${APP_VOL}" ] && break
    done
fi

if [ -n "${TRIM_PKGVAR:-}" ]; then
    DATA_DIR="${TRIM_PKGVAR}"
elif [ -n "${APP_VOL}" ]; then
    DATA_DIR="${APP_VOL}/@appdata/${APP_NAME}"
else
    DATA_DIR="${APP_DIR}/var"
fi

LOG="${DATA_DIR}/install.log"
DSH_HOME="${DATA_DIR}/dsh_home"
CONSOLE_PORT="${CONSOLE_PORT:-28001}"
DSH_PORT="${DSH_PORT:-28000}"

mkdir -p "${DATA_DIR}" "${DSH_HOME}/profiles" "${DATA_DIR}/versions" 2>/dev/null || true
echo "[$(date '+%F %T')] install_callback start (user=$(id -un) uid=$(id -u) app=${APP_NAME})" >> "${LOG}"
echo "[$(date '+%F %T')] paths: APP_DIR=${APP_DIR} DATA_DIR=${DATA_DIR} DSH_HOME=${DSH_HOME}" >> "${LOG}"

# ── node 定位 (面板与后续 npm install 都靠它) ──
# fnOS 依赖应用按版本隔离, 真实路径 /var/apps/nodejs_*/target/bin 或
# /vol{n}/@appcenter/nodejs_*/bin, 版本号会变所以按 nodejs_* 通配扫描.
NODE_DIR=""
for cand in /var/apps/nodejs_*/target/bin /var/apps/nodejs_*/bin \
            /vol[0-9]*/@appcenter/nodejs_*/bin /vol[0-9]*/@appcenter/nodejs_*/target/bin \
            "${APP_VOL}/@appcenter/nodejs_*/bin"; do
    [ -x "$cand/node" ] && NODE_DIR="$cand" && break
done
if [ -n "${NODE_DIR}" ]; then
    export PATH="${NODE_DIR}:${PATH}"
    echo "[$(date '+%F %T')] node: ${NODE_DIR}/node $( "${NODE_DIR}/node" -v 2>/dev/null )" >> "${LOG}"
else
    echo "[$(date '+%F %T')] WARN: node not found in fnOS paths; using $(command -v node || echo none)" >> "${LOG}"
fi

# ── 安装向导: DeepSeek API Key ──
# 面板的登录密码默认就是这个 key (没设则回落到面板内置的 dsh),
# 所以这里必须按 dsh 自己的规矩写成 600, 否则 dsh 启动直接拒绝.
if [ -n "${wizard_deepseek_api_key:-}" ]; then
    printf 'DEEPSEEK_API_KEY: %s\n' "${wizard_deepseek_api_key}" > "${DSH_HOME}/.credentials.yaml"
    chmod 600 "${DSH_HOME}/.credentials.yaml" 2>/dev/null || true
    echo "[$(date '+%F %T')] wrote .credentials.yaml (mode 600)" >> "${LOG}"
fi

# ── 安装向导: 出站代理 ──
if [ -n "${wizard_proxy_ip:-}" ] && [ -n "${wizard_proxy_port:-}" ]; then
    printf 'PROXY=http://%s:%s\n' "${wizard_proxy_ip}" "${wizard_proxy_port}" > "${DSH_HOME}/proxy.conf"
    chmod 600 "${DSH_HOME}/proxy.conf" 2>/dev/null || true
    echo "[$(date '+%F %T')] proxy.conf: http://${wizard_proxy_ip}:${wizard_proxy_port}" >> "${LOG}"
fi

# ── 安装向导: 信任域 ──
# FN Connect ID 自动拼 <id>.fnos.net / dsh.<id>.fnos.net / fnos.net,
# 再加可选的自定义域名, 一行一个. 面板和 dsh 的 trusted_hosts 读同一份.
{
    if [ -n "${wizard_fnos_id:-}" ]; then
        FN_ID="$(printf '%s' "${wizard_fnos_id}" | tr -d '[:space:]' | sed 's#^https\?://##; s#/$##; s#\.fnos\.net$##')"
        [ -n "${FN_ID}" ] && printf '%s\n%s\n%s\n' "${FN_ID}.fnos.net" "dsh.${FN_ID}.fnos.net" "fnos.net"
    fi
    if [ -n "${wizard_custom_domain:-}" ]; then
        printf '%s' "${wizard_custom_domain}" | tr -d '[:space:]' | sed -e 's#^https\?://##' -e 's#/$##'
    fi
} > "${DSH_HOME}/trusted_hosts.conf" 2>/dev/null
if [ -s "${DSH_HOME}/trusted_hosts.conf" ]; then
    chmod 600 "${DSH_HOME}/trusted_hosts.conf" 2>/dev/null || true
    echo "[$(date '+%F %T')] trusted_hosts.conf: $(tr '\n' ' ' < "${DSH_HOME}/trusted_hosts.conf")" >> "${LOG}"
else
    rm -f "${DSH_HOME}/trusted_hosts.conf" 2>/dev/null || true
fi

# ── 面板配置初值 ──
# 只写不存在的字段: 升级时不能把用户改过的覆盖回去.
#
# 这个文件必须是**严格 JSON**: 注释会让 dashboard-config.js 的 JSON.parse 直接
# 抛错, 而 loadConfig() 把异常吞掉后回落到 DEFAULTS —— 于是用户装套件时设的
# lanBind / npm 代理 / 快捷入口全部静默消失, 且面板不报任何错。所以这里的
# 说明只能写在 shell 注释里, 不能写进 JSON 本体。
if [ ! -f "${DATA_DIR}/console-config.json" ]; then
    PROXY_URL=""
    if [ -n "${wizard_proxy_ip:-}" ] && [ -n "${wizard_proxy_port:-}" ]; then
        PROXY_URL="http://${wizard_proxy_ip}:${wizard_proxy_port}"
    fi
    cat > "${DATA_DIR}/console-config.json" <<EOF
{
  "mode": "auto",
  "lanBind": false,
  "proxy": { "enabled": true, "pathPrefix": "/p" },
  "access": { "enabled": true, "max": 500, "trustProxyHeaders": true },
  "versions": { "keep": 3 },
  "install": {
    "npmRegistry": "https://registry.npmjs.org",
    "proxy": "${PROXY_URL}"
  },
  "shortcuts": []
}
EOF
    chmod 600 "${DATA_DIR}/console-config.json" 2>/dev/null || true
    # 写完立刻自检: 与其等到面板默默用默认值, 不如当场发现并留下日志证据。
    if "${NODE_BIN:-node}" -e "JSON.parse(require('fs').readFileSync('${DATA_DIR}/console-config.json','utf8'))" 2>/dev/null; then
        echo "[$(date '+%F %T')] created console-config.json (valid JSON)" >> "${LOG}"
    else
        echo "[$(date '+%F %T')] ERROR: console-config.json is not valid JSON; panel will fall back to defaults" >> "${LOG}"
    fi
fi

# ── 属主修正 ──
# 服务账号要能读凭据(600)、写数据与日志. 失败不致密, 记一笔即可.
if id "${APP_NAME}" >/dev/null 2>&1; then
    chown -R "${APP_NAME}:${APP_NAME}" "${DATA_DIR}" 2>/dev/null \
        && echo "[$(date '+%F %T')] chowned ${DATA_DIR} to ${APP_NAME}" >> "${LOG}" \
        || echo "[$(date '+%F %T')] WARN: chown ${DATA_DIR} failed" >> "${LOG}"
fi

echo "[$(date '+%F %T')] install_callback done" >> "${LOG}"
exit 0
